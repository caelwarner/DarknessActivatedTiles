<fieldset>
	<legend>{{ localize "LIGHT.FIELDS.darkness.label" }}</legend>
	<div class="form-group slim">
		<label>{{ localize "darkness-activated-tiles.Range" }}</label>
		<div class="form-fields">
			<label for="{{ rootId }}-darkness-min">{{ localize "LIGHT.FIELDS.darkness.min.label" }}</label>
			<input type="number" id="{{ rootId }}-darkness-min" name="flags.darkness-activated-tiles.darkness.min" value="{{ min }}" placeholder="0" step="any" min="0" max="1">
			<label for="{{ rootId }}-darkness-max">{{ localize "LIGHT.FIELDS.darkness.max.label" }}</label>
			<input type="number" id="{{ rootId }}-darkness-max" name="flags.darkness-activated-tiles.darkness.max" value="{{ max }}" placeholder="1" step="any" min="0" max="1">
		</div>
		<p class="hint">{{ localize "darkness-activated-tiles.RangeHint" }}</p>
	</div>
	<div class="form-group slim">
		<label>{{ localize "darkness-activated-tiles.FadeDuration" }} <span class="units">({{ localize "TIME.Millisecond.abbr" }})</span></label>
		<div class="form-fields">
			<label for="{{ rootId }}-darkness-fade-in">{{ localize "darkness-activated-tiles.FadeIn" }}</label>
			<input type="number" id="{{ rootId }}-darkness-fade-in" name="flags.darkness-activated-tiles.darkness.fadeIn" value="{{ fadeIn }}" placeholder="{{ defaultFadeIn }}" step="100" min="0">
			<label for="{{ rootId }}-darkness-fade-out">{{ localize "darkness-activated-tiles.FadeOut" }}</label>
			<input type="number" id="{{ rootId }}-darkness-fade-out" name="flags.darkness-activated-tiles.darkness.fadeOut" value="{{ fadeOut }}" placeholder="{{ defaultFadeOut }}" step="100" min="0">
		</div>
		<p class="hint">{{ localize "darkness-activated-tiles.FadeDurationHint" }}</p>
	</div>
</fieldset>
